<!> spellcutin 1
<!> type(spell, `Ninth Hell Sign - Gnawing at the Great Cage of Ice`)
<!> hp(25000)
<!> root(0, 2.5)
phase 60 #{
	paction(0)
	$mimapower2	
	gtrepeat({
		bindItr(loop)
	}, {
		move(_, nroffset(pxy(sine(pm1(&loop) * 0.1, 0.2, t / 6), 0)))
	})
	async(gem-blue/w, <2;:>, gcrepeat {
				delay(2s)
				times(_)
				wait(120)
			} gsrepeat {
				root pxy [Lplayer].x [Lplayer].y
				times(100)
				sfx x-metal
				circle
			} s(rvelocity(cxy(0, 0))))
			collide sbonsb triangle-blue/w gem-blue/w _ _ {
				softcull(_, _)
			} { 
				restyleeffect(arrow-blue/w, cwheel-blue/w, _)
			}
			bullet-control(persist, arrow-blue/w, batch(> t 0.7, {
				sm(_, async arrow-blue/b <> gcrepeat {
					wait(12)
					times(1)
					rv2incr(<0.4;:>)
					sfx(x-transform-1)
				} gsrepeat {
					times(1)
					circle
				} s(rvelocity(px(lerpt(0.3, 1.4, 0, -2.6)))))
				cull(_)
			}))
			bullet-control persist {{ gem-blue/w }} cull > t 1.5
		gtrepeat({
			delay(2s)
			times(_)
			wait(0.5s)
			wait-child
			alternate(t)
		}, {
			async triangle-blue/w <1;0:0;0:0> gcrepeat {
				p this
			} gsrepeat {
				times(10)
				sfx x-fire-burst-1
				target(ra, Lplayer)
				bindArrow
				preloop {
					rv2.rx =f ([&brv2].rx + -0.1 * &aixd)
					rv2.ry =f ([&brv2].ry + 0.1 * &aiyd)
				}
			} s rvelocity(px(3))
			async triangle-blue/w <-1;0:0;0:0> gcrepeat {
				p this
			} gsrepeat {
				times(10)
				sfx x-fire-burst-1
				target(ra, Lplayer)
				bindArrow
				preloop {
					rv2.rx =f ([&brv2].rx + -0.1 * &aixd)
					rv2.ry =f ([&brv2].ry + 0.1 * &aiyd)
				}
			} s rvelocity(px(3))
			async triangle-blue/w <0;0:0;0:0> gcrepeat {
				p this
			} gsrepeat {
				times(10)
				sfx x-fire-burst-1
				target(ra, Lplayer)
				bindArrow
				preloop {
					rv2.rx =f ([&brv2].rx + -0.1 * &aixd)
					rv2.ry =f ([&brv2].ry + 0.1 * &aiyd)
				}
			} s rvelocity(px(3))
			async triangle-blue/w <> gcrepeat {
				p this
			} gsrepeat {
				times(10)
				sfx x-fire-burst-1
				root pxy(([Lplayer].x) + 4, ([Lplayer].y))
				target(ra, Lplayer)
				bindArrow
				preloop {
					rv2.rx =f ([&brv2].rx + -0.1 * &aixd)
					rv2.ry =f ([&brv2].ry + 0.1 * &aiyd)
				}
			} s rvelocity(px(3))
			async triangle-blue/w <> gcrepeat {
				p this
			} gsrepeat {
				times(10)
				sfx x-fire-burst-1
				root pxy(([Lplayer].x) - 4, ([Lplayer].y))
				target(ra, Lplayer)
				bindArrow
				preloop {
					rv2.rx =f ([&brv2].rx + -0.1 * &aixd)
					rv2.ry =f ([&brv2].ry + 0.1 * &aiyd)
				}
			} s rvelocity(px(3))
		})

##9
<!> type(non, ``)
<!> hp(15000)
<!> root(0, 2.5)
!{ 
	mimapower3()
	sync powerup1 <> poweraura boss1
		witha 0.9 lerp 0 3 t yellow yellow
		witha 0.9 yellow
!}
	phase 60 #{
		paction(0)
		$mimapower3
		gtrepeat({
			bindItr(loop)
		}, {
			move(_, nroffset(pxy(sine(pm1(&loop) * 0.1, 0.2, t / 6), 0)))
		})
		gtrepeat({
				times(_)
				wait(2s)
				wait-child
				alternate(t)
			}, {
				sync *-red* <-1;0:0;0:0> gsrepeat {
					times(3)
					color { pather gpather lightning }
					circle
				} gsrepeat {
					times(8)
					sfx  { x-lightning }
					target(ra, Lplayer)
					spread(<360>)
					color { /b / /w }
				} pather(2, 1 + sine(1.6, 0.4, t), 
					roffset(pxy(sine(3, 2, t), 4 * t)), {
						hueshift(120 * t)
				})
	
				sync *-red* <1;0:0;0:0> gsrepeat {
					times(3)
					color { pather gpather lightning }
					circle
				} gsrepeat {
					times(8)
					sfx  { x-lightning }
					target(ra, Lplayer)
					spread(<360>)
					color { /b / /w }
				} pather(2, 1 + sine(1.6, 0.4, t), 
					roffset(pxy(4 * t, sine(3, 2, t))), {
						hueshift(120 * t)
				})
			})
			async empty <> gcr2 360 _ <;:60h> {
				p this
			} gsr2c 4 {
				p add
			} s polar
				* 1.3 t
				* pm1mod p1 softmaxshiftt 0.4 1 0 (* 25 t)
			bullet-control persist empty savev2 el p loc _
			async inode <> gcr2 360 _ <> { 
				p this 
				root zero
			} gsr2 4 <> { 
				p add
				alternate p1 
			} { 
					summons offset zero @ el p
						paction 0
							sync scircle-yellow/w <> world s offset zero @ el p
							async gcircle-yellow/b <0.1;:> gcr2 120 _ <> {
								delay	90
								while	onscreen loc
								sfx	x-fire-burst-1
								##I think this bullet is better homing.
							} gsr2c 4 {
							} s tprot lerpin 0 1.5 ss 0 vhome 1 Lplayer ##cx 0.8
							break
					summons offset zero @ el p
						paction 0
							sync scircle-yellow/b <> world  s offset zero @ el p
							async gcircle-yellow/w <0.1;:> gcr2 120 _ <20h> {
								delay	90
								while	onscreen loc
								sfx	x-fire-burst-2
							} gsr2c 4 {
							} s tprot lerpin 0 1.5 cx 2.2
							break
				}
	
	
	#}
	
