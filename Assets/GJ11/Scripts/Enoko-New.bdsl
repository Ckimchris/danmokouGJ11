##11
<!> spellcutin 3
<!> type(timeout, `Mine Sign - Fastest Wolves and Slow and Steady Doggies`)
!!{ w 10
!!{ d 1.2
!{ 
mimapower3()
sync powerup1 <> poweraura boss1
	witha 0.9 lerp 0 3 t yellow yellow
	witha 0.9 yellow
!}
<!> root(0, 2.5)
phase(32)
	paction(0)
	gtrepeat({
		bindItr(loop)
	}, {
		move(_, nroffset(pxy(sine(pm1(&loop) * 0.1, 0.2, t / 6), 0)))
	})
pool-control {{ stelldecagon-red/w }} destructible false
	async stelldecagon-red/w <> gir2 12 12 <> {
		p this
	} gir2 0 16 <> {
		p add
	} {
		gcr {
			root pxy [Lplayer].x [Lplayer].y
			delay 120
			sfx x-metal
		} simple nroffset pxy($d * (p2 + 0.5 - $w / 2), -4 + $d * p1) {
		}
	}
	gtrepeat({
		times(6)
		delay(4s)
		wait(4s)
		wait-child
		p this
	}, {
		gtrepeat({
			wait-child
			sequential
		}, {
			async lightning-yellow/w <1;:180> gcrepeat {
				times(1)
				wait(2s)
				sfx  { x-lightning }
			} gsrepeat {
				times(12)
				rv2incr(<10>)
				target(angle, Lplayer)
				center
				bindAngle
			} pather(1, 0.4, nrvelocity(
					* lerp3(0.0, 0.6, 1.1, 1.3, t, 9, 2, 12)
					truerotatelerprate(300, rx(1, &angle),
						stopsampling(0.4, vhome(2, Lplayer)))),
				{ })
			async arrowpather-blue/w <1;:180> gcrepeat {
				times(1)
				delay(0.5s)
				sfx({ x-fire-tech-6 x-fire-tech-8 })
				p add
			} gsrepeat {
				times((p1 + 1) * 2)
				rv2incr(<10>)
				target(angle, Lplayer)
				center
				bindAngle
			} pather(1, 0.4, nrvelocity(
					* lerp3(0.0, 0.6, 1.1, 1.3, t, 9, 2, 4)
					truerotatelerprate(300, rx(1, &angle),
						stopsampling(3, vhome(2, Lplayer)))),
				{ })
		})
	})

##12
<!> spellcutin 3
<!> type(spell, `Roar of the King - The Fangs of the Three Headed Yamainu`)
<!> hp(50000)
!!{ blue { blue }	
!{ 
mimapower4()
sync powerup1 <> poweraura boss1
	witha 0.9 lerp 0 3 t yellow blue
	witha 0.9 red
!}
<!> root(0, 2.5)
phase(100)#{
	paction(0)
		$mimapower4
		gtrepeat({
			bindItr(loop)
		}, {
			move(_, nroffset(pxy(sine(pm1(&loop) * 0.1, 0.2, t / 6), 0)))
		})
		gtrepeat({
			delay(2s)
		}, 
		{
			async lightning-* <> gcr2 150 _ <20h> {
				delay 1.5s
				color { red* pink* }
				p this
				sfx  { x-lightning }
			} gsr2 18 <20> {
				color { /w / }
			} pather 1 1
				polar
					* 4 t
					* pm1mod p * 10 sine(1.6, 0.4, t)
			{ }
			async gem-* <1;0:0.2;0:-90> gcr2 16 _ <35> {
				color { */b */ */w }
			} gsr2 8 <45> {
				bank <0.4;:180>
				sfx x-fire-burst-2
				color $blue
			} s tprot lerpin 0.3 1 cx 3
			async fireball-* <-1;0:0.5;0:-90> gcr2 16 _ <35> {
				color { */b */ */w }
			} gsr2 4 <90> {
				bank <0.6;:180>
				sfx x-fire-burst-3
				color $red
			} s tprot lerpin 0.3 1 cx 4
		})
#}

