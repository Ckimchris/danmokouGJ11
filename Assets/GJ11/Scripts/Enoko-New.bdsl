					rv2incr(<5>)
					center
				} pather(1, 1, tprot cx 10, { 
					sm async amulet-yellow/b <> gcrepeat ({
						wait(17)
						times(_)
						face(rotvel)
					}, s(rvelocity(lerpt(1, 2, zero, cx(4)))))
				})
				gcrepeat {
					colorr lightning-yellow/w
					sfx({ x-lightning })
					times(3)
					rv2incr(<10>)
					center
				} pather(1, 1, tprot cx 10, { 
					sm async amulet-yellow/b <> gcrepeat ({
						wait(17)
						times(_)
						face(rotvel)
					}, s(rvelocity(lerpt(1, 2, zero, cx(-4)))))
				})
			})
			move-target 0.5 in-sine pxy([@0 ploc].x,  -4)
		})
		gtrepeat({
			wait-child
			sequential
		}, {
			savev2 ploc 0 Lplayer
			move-target 1 in-sine pxy([@0 ploc].x, -4)
			sync zonelaser-yellow* <90> gsr2c 1 {
				color { /b / /w }
			} safelaser 2 { 
				dsfx
				s(4)
			}
