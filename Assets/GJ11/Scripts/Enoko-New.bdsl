<!> spellcutin 2
<!> type(spell, `Second Hell Sign - Warped Fangs Wreathed in Lightning`)
<!> hp(25000)
!{ 
mimapower3()
sync powerup1 <> poweraura boss1
	witha 0.9 lerp 0 3 t yellow yellow
	witha 0.9 yellow
!}
<!> root(0, 2.5)
phase 60 #{
	paction 0
	gtrepeat({
		times(_)
		wait(2s)
		wait-child
		sequential
	}, {
		async(_, <>, girepeat {
			times(1)
			delay(1s)
		} {
			gcrepeat {
				colorr lightning-yellow/
				root pxy 3.5 4
				times(5)
				rv2incr(<7.5>)
				target(angle, Lplayer)
				center
				sfx({ x-lightning })
			} pather(1, 1, tprot cx 8, { 
				sm async gem-yellow/b <> gcrepeat {
					wait(20)
					cancel(offscreen(loc))
					times(_)
					face(velocity)
				} s(rvelocity(cx(2)))
			})
		})
		async(_, <>, girepeat {
			times(1)
			delay(1s)
		} {
			gcrepeat {
				colorr lightning-yellow/
				root pxy -3.5 4
				times(5)
				rv2incr(<7.5>)
				target(angle, Lplayer)
				center
				sfx({ x-lightning })
			} pather(1, 1, tprot cx 8, { 
				sm async gem-yellow/b <> gcrepeat {
					wait(20)
					cancel(offscreen(loc))
					times(_)
					face(velocity)
				} s(rvelocity(cx(2)))
			})
		})
		gtrepeat({
			delay(1s)
			wait-child
			sequential
		}, {
			savev2 ploc 0 Lplayer
			move-target 1 in-sine pxy([@0 ploc].x, 3)
			sync zonelaser-yellow* <-90> gsr2c 1 {
				color { /b / /w }
