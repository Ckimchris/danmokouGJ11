##7
<!> type(non, ``)
<!> hp(15000)
!{ 
mimapower2()
sync powerup1 <> poweraura boss1
	witha 0.9 lerp 0 3 t blue teal
	witha 0.9 blue
!}
<!> root(0, 3)
phase(60)
	paction(0)
	$mimapower2
	gtrepeat({
		bindItr(loop)
	}, {
		move(_, nroffset(pxy(sine(pm1(&loop) * 2, 3, t / 6), 0)))
	})
	gtrepeat({
		wait(2s)
		times(_)
		wait-child
		sequential
	}, {
		async triangle-blue/w <-90> gcrepeat {
			times(15)
			wait 10
			p this
		} gsrepeat {
			times(20)
			sfx x-metal
			root pxy(rand([Lplayer].x - 2, [Lplayer].x + 2), rand(3, 4))
			bindArrow
			preloop {
				rv2.rx =f ([&brv2].rx + -0.1 * &aixd)
				rv2.ry =f ([&brv2].ry + 0.1 * &aiyd)
			}
		} s(rvelocity(lerpt(1, 2, zero, cx(3))))
	})
	async gcircle-blue/ <> gcr2 24 _ <> {
		root cxy 0 4
		sfx(x-transform-1)
		frv2(rx(rand(-4, 4)))
	} s tpnrot py lerp3(0.5, 1.5, 2.5, 3.5, mod(4, t + brand(0, 4)), -1.4, -1.7, -1.4)

