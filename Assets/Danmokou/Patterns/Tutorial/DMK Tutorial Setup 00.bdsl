<#> warnprefix
## Go to https://dmk.bagoum.com/docs/articles/tbosses.html for the tutorial. 
pattern({ 
	##boss(mynewboss)
})
phase(0)
	paction(0)
		shift-phase-to(8)
		
<!> type(non, `This is a nonspell`)
<!> hp(4000)
<!> root(0, 2)
phase(0)
	paction(0)
		gtrepeat({
			wait(20)
			times(_)
			wait-child
			sequential
		}, {
			async(fireball-red/, <-1;0:0;0:0>, gcrepeat({
				wait(20)
				times(_)
				for(2s)
			}, gsrepeat({
				times(20)
				circle
			}, s(polar(3 * t, 30 * t)))))
			async(fireball-red/, <1;0:0;0:0>, gcrepeat({
				wait(20)
				times(_)
				for(2s)
			}, gsrepeat({
				times(20)
				circle
			}, s(polar(3 * t, -30 * t)))))
			async(fireball-red/, <0;0:0;0:0>, gcrepeat({
				wait(20)
				times(_)
				for(2s)
				bindLR ##bindLR is simpler to use than pm1 p
				##p this
			}, gsrepeat({
				times(30)
				circle
			}, s(polar(3 * t, * &lr * 8 t)))))
		})

<!> type(non, `This is a nonspell`)
<!> hp(4000)
<!> root(0, 2)
phase(0)
	paction(0)
		async fireball-red/ <1;0:1;0:0> gir2 150 _ <> { 
			p this
		} gcr {
			wt	8 4
			rpp	angle * pm1 p 2.3h
        } gsr2c 24 {
        } s polar
			pivot t 1.5
				sine 3 2 t
				* t -3
			* pm1 p + 90 * -3 t
		async fireball-red/ <-1;0:1;0:0> gir2 150 _ <> { 
			p this
		} gcr {
			wt	8 4
			rpp	angle * pm1 p 2.3h
        } gsr2c 24 {
        } s polar
			pivot t 1.5
				sine 3 2 t
				* t 3
			* pm1 p - 90 * 3 t
		async(scircle-red/w, <>, girepeat {
			times(1)
		} gcrepeat {
			times(_)
			wait(100)
		} gsrepeat {
			target(ra, Lplayer)
		} s(rvelocity(lerpt(0, 1, zero, cx(4)))))


