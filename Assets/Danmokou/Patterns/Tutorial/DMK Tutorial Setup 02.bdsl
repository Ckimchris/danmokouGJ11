					} gsrepeat {
						root pxy [Lplayer].x [Lplayer].y
						times(24)
						sfx x-metal
						circle
					} s(rvelocity(cxy(0, 0))))
					async(stelldecagon-red/w, <3;:>, gcrepeat {
						times(1)
						wait(73)
					} gsrepeat {
						root pxy [Lplayer].x [Lplayer].y
						times(16)
						sfx x-metal
						circle
					} s(rvelocity(cxy(0, 0))))
					async(stelldecagon-red/w, <2;:>, gcrepeat {
						times(1)
						wait(73)
					} gsrepeat {
						root pxy [Lplayer].x [Lplayer].y
						times(8)
						sfx x-metal
						circle
					} s(rvelocity(cxy(0, 0))))
					async(stelldecagon-red/w, <1;:>, gcrepeat {
						times(1)
						wait(73)
					} gsrepeat {
						root pxy [Lplayer].x [Lplayer].y
						times(5)
						sfx x-metal
						circle
					} s(rvelocity(cxy(0, 0))))
					sync zonelaser-red* <> gsr2c 1 {
						color { /b / /w }
						target(ra, Lplayer)
						savev2 ploc 0 Lplayer
					} safelaser 2 { 
						dsfx
