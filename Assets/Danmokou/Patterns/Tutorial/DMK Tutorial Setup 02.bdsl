						}, gsrepeat({
							times(20)
							sfx x-fire-burst-3
							center
							target ra @0 ploc
							spread(<30>)
						}, s(rvelocity(cxy(3, 0))))))
					})
					async(dot-red/w, <0;0:0;0:-180>, girepeat({
						wait(60)
						times(5)
						sfx x-fire-burst-2
					}, gsrepeat({				
							times(60)
							circle
