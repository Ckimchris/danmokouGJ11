					))
				})

<!> type(non, `This is a nonspell`)
<!> hp(4000)
<!> root(0, 3)
phase(0)
	paction(0)
	gtrepeat({
		bindItr(loop)
	}, {
		move(_, nroffset(pxy(sine(pm1(&loop) * 2, 3, t / 6), 0)))
	})
	gtrepeat({
		wait(2s)
		times(_)
		wait-child
		sequential
	}, {
		async triangle-blue/w <-90> gcrepeat {
			times(10)
			wait 10
			p this
		} gsrepeat {
			times(11)
			root pxy(rand([Lplayer].x - 2, [Lplayer].x + 2), rand(3, 4))
			bindArrow
			preloop {
				rv2.rx =f ([&brv2].rx + -0.1 * &aixd)
				rv2.ry =f ([&brv2].ry + 0.1 * &aiyd)
			}
		} s(rvelocity(cx(2)))
	})
	async gcircle-blue/ <> gcr2 24 _ <> {
		root cxy 0 4
		frv2(rx(rand(-4, 4)))
	} s tpnrot py lerp3(0.5, 1.5, 2.5, 3.5, mod(4, t + brand(0, 4)), -1.4, -1.7, -1.4)

<!> type non `Pathers`
<!> roott(1, 0, 2)
!!{ w 10
!!{ d 1.2
phase(27)
	paction(0)
pool-control {{ stelldecagon-red/w }} destructible false
	async stelldecagon-red/w <> gir2 12 12 <> {
		p this
	} gir2 0 16 <> {
		p add
	} {
		gcr {
			root pxy [Lplayer].x [Lplayer].y
			delay 120
			sfx x-metal
		} simple nroffset pxy($d * (p2 + 0.5 - $w / 2), -4 + $d * 1) {
		}
	}
	gtrepeat({
		times(5)
		delay(4s)
		wait(4s)
		wait-child
		p this
	}, {
		gtrepeat({
			wait-child
			sequential
		}, {
			async lightning-yellow/w <1;:180> gcrepeat {
				times(1)
				wait(2s)
				sfx  { x-lightning }
			} gsrepeat {
				times(12)
				rv2incr(<10>)
				target(angle, Lplayer)
				center
				bindAngle
			} pather(1, 0.4, nrvelocity(
					* lerp3(0.0, 0.6, 1.1, 1.3, t, 9, 2, 12)
					truerotatelerprate(300, rx(1, &angle),
						stopsampling(0.4, vhome(2, Lplayer)))),
				{ })
			async arrowpather-blue/w <1;:180> gcrepeat {
				times(1)
				delay(0.5s)
				sfx({ x-fire-tech-6 x-fire-tech-8 })
				p add
			} gsrepeat {
				times((p1 + 1) * 2)
				rv2incr(<10>)
				target(angle, Lplayer)
				center
				bindAngle
			} pather(1, 0.4, nrvelocity(
					* lerp3(0.0, 0.6, 1.1, 1.3, t, 9, 2, 4)
					truerotatelerprate(300, rx(1, &angle),
						stopsampling(3, vhome(2, Lplayer)))),
				{ })
		})
	})