pattern({ 
	##boss(mynewboss)
})
phase(0)
	paction(0)
		shift-phase-to(4)

<!> type(non, `This is a nonspell`)
<!> hp(4000)
<!> root(0, 3)
phase(0)
	paction(0)
	gtrepeat({
		bindItr(loop)
	}, {
		move(_, nroffset(pxy(sine(pm1(&loop) * 0.1, 0.2, t / 6), 0)))
	})
	gtrepeat({
			wait(20)
			times(_)
			wait-child
			sequential
		}, {
			async(fireball-red/, <>, gcrepeat({
				wait(20)
				times(_)
				for(2s)
			}, gsrepeat({
				times(30)
				sfx x-fire-burst-3
				circle
				root pxy 1 3
			}, s(polar(3 * t, 30 * t)))))
			async(fireball-red/, <0;0:0;0:0>, gcrepeat({
				wait(40)
				times(_)
				for(2s)
				bindLR ##bindLR is simpler to use than pm1 p
				##p this
			}, gsrepeat({
				times(20)
				sfx x-fire-burst-3
				spread(<-180>)
			}, s(rvelocity(cx(2))))))
			async(fireball-red/, <>, gcrepeat({
				wait(20)
				times(_)
				for(2s)
			}, gsrepeat({
				times(20)
				sfx x-fire-burst-3
				circle
				root pxy -1 3
			}, s(polar(3 * t, -45 * t)))))
			async(fireball-red/, <0;0:0;0:0>, gcrepeat({
				wait(40)
				times(_)
				for(2s)
				bindLR ##bindLR is simpler to use than pm1 p
				##p this
			}, gsrepeat({
				times(20)
				sfx x-fire-burst-3
				spread(<-180>)
			}, s(rvelocity(cx(2))))))
		})

<!> type(non, `This is a nonspell`)
<!> hp(4000)
<!> root(0, 3)
phase(0)
	paction(0)
		async fireball-red/ <2;0:1;0:0> gir2 150 _ <> { 
			delay(1s)
			p this
			bindItr(loop)
		} gcr {
			wt	8 4
			rpp	angle * pm1 p 2.3h
		} gsr2c 24 {
			sfx x-fire-burst-3
		} s polar
			pivot t 1.5
				sine 3 2 t
				* t (3 * pm1(&loop))
			* pm1 p + 90 * 3 t
		async fireball-red/ <-2;0:1;0:0> gir2 150 _ <> { 
			delay(1s)
			p this
			bindItr(loop)
		} gcr {
			wt	8 4
			rpp	angle * pm1 p 2.3h
		} gsr2c 24 {
			sfx x-fire-burst-3
		} s polar
			pivot t 1.5
				sine 3 2 t
				* t (3 * pm1(&loop))
			* pm1 p + 90 * 3 t
		gtrepeat({
			delay(4s)
			wait(100)
			times(_)
			alternate(t)
		}, {
			async(scircle-red/w, <0;0:0;0:0>, gsrepeat {
				sfx x-fire-burst-1
				target(angle, Lplayer)
			} s(rvelocity(lerpt(0, 1, zero, cx(4)))))
			async(scircle-red/w, <0;0:0;0:0>, gsrepeat {
				sfx x-fire-burst-1
				root pxy 2 3
				target(angle, Lplayer)
			} s(rvelocity(lerpt(0, 1, zero, cx(4)))))
			async(scircle-red/w, <0;0:0;0:0>, gsrepeat {
				sfx x-fire-burst-1
				root pxy -2 3
				target(angle, Lplayer)
			} s(rvelocity(lerpt(0, 1, zero, cx(4)))))
			
		})

##4
!!{ red { red }	
<!> type(non, ``)
<!> hp(15000)
<!> root(0, 2.5)
phase(30)
	paction(0)
		gtrepeat({
			wait(1)
			times(_)
			wait-child
			sequential
		}, {
			async fireball-* <0;0:0.5;0:-90> gcr2 16 _ <35> {
				wait(10)
				times(_)
				for(3s)
				color { */b */ */w }
			} gsr2 8 <45> {
				bank <0.6;:180>
				sfx x-fire-burst-3
				color $red
			} s tprot lerpin 0.3 1 cx 4
		})
		gtrepeat({
			wait(20)
			times(_)
			wait-child
			sequential
		}, {
			async(fireball-red/, <1;0:0;0:180>, gcrepeat({
				wait(20)
				times(_)
				for(2s)
				bindLR ##bindLR is simpler to use than pm1 p
				##p this
			}, gsrepeat({
				times(10)
				sfx x-fire-burst-3
				spread(<180>)
			}, s(polar(3 * t, * &lr * 8 t)))))
			async(fireball-red/, <-1;0:0;0:180>, gcrepeat({
				wait(10)
				times(_)
				for(2s)
				bindLR ##bindLR is simpler to use than pm1 p
				##p this
			}, gsrepeat({
				times(10)
				sfx x-fire-burst-3
				spread(<180>)
			}, s(polar(3 * t, * &lr * 8 t)))))
		})

		<!> type(spell, `Watch Your Step "Gnarly Hot Stuff"`)
		<!> hp(20000)
		<!> root(0, 2.5)
